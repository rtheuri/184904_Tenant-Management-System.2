<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="tenant"
            type="com.example.tenantmanagementsystem2.data.model.Tenant" />
    </data>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:background="@color/background">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp">

            <TextView
                android:id="@+id/newTenantLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Just Added"
                android:textColor="@color/on_surface"
                android:textSize="20sp"
                android:fontFamily="sans-serif-black"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- Highlight Card for newly added tenant -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/newTenantCardView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:strokeWidth="1.5dp"
                app:strokeColor="#A7F3D0"
                app:cardBackgroundColor="@color/surface"
                app:layout_constraintTop_toBottomOf="@id/newTenantLabel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/newTenantTextView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@{tenant.summary()}"
                        android:textColor="@color/on_surface"
                        android:textSize="16sp"
                        android:lineSpacingExtra="4dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/callButton"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="16dp"
                        android:text="CALL TENANT"
                        android:textSize="14sp"
                        android:letterSpacing="0.05"
                        android:textStyle="bold"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_phone"
                        app:iconGravity="textStart"
                        app:iconPadding="8dp"
                        android:backgroundTint="@color/call_action"
                        app:elevation="2dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <androidx.constraintlayout.widget.Group
                android:id="@+id/newTenantGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="newTenantLabel,newTenantCardView" />

            <TextView
                android:id="@+id/allTenantsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="All Tenants"
                android:textColor="@color/on_surface"
                android:textSize="20sp"
                android:fontFamily="sans-serif-black"
                android:layout_marginTop="28dp"
                app:layout_goneMarginTop="0dp"
                app:layout_constraintTop_toBottomOf="@id/newTenantCardView"
                app:layout_constraintStart_toStartOf="parent" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/allTenantsCardView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/outline_variant"
                app:cardBackgroundColor="@color/surface"
                app:layout_constraintTop_toBottomOf="@id/allTenantsLabel"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/allTenantsTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp"
                    android:textColor="@color/on_surface"
                    android:textSize="15sp"
                    android:lineSpacingExtra="6dp" />

            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</layout>
