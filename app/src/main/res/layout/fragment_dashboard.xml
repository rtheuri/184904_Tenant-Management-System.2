<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="viewModel"
            type="com.example.tenantmanagementsystem2.ui.viewmodel.TenantViewModel" />
    </data>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:background="@color/background">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp">

            <TextView
                android:id="@+id/welcomeTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Welcome back 👋"
                android:textColor="@color/on_surface"
                android:textSize="26sp"
                android:fontFamily="sans-serif-black"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/overviewTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Here is a live summary of your property portfolio"
                android:textColor="@color/on_surface_variant"
                android:textSize="15sp"
                app:layout_constraintTop_toBottomOf="@id/welcomeTextView"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- Stat Card 1: Tenants Count -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tenantCountCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="8dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="1dp"
                app:strokeColor="#BFDBFE"
                app:cardBackgroundColor="@color/stat_tenants_bg"
                app:layout_constraintTop_toBottomOf="@id/overviewTextView"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/totalRentCard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_people"
                        android:contentDescription="Tenants Icon" />

                    <TextView
                        android:id="@+id/tenantCountTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@{`Tenants&#10;` + viewModel.tenants.size()}"
                        android:textColor="@color/stat_tenants_text"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:lineSpacingExtra="4dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Stat Card 2: Total Rent -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/totalRentCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="1dp"
                app:strokeColor="#A7F3D0"
                app:cardBackgroundColor="@color/stat_rent_bg"
                app:layout_constraintTop_toTopOf="@id/tenantCountCard"
                app:layout_constraintStart_toEndOf="@id/tenantCountCard"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_payments"
                        android:contentDescription="Rent Icon" />

                    <TextView
                        android:id="@+id/totalRentTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@{String.format(`Total rent&#10;KSh %,.0f`, viewModel.totalRent)}"
                        android:textColor="@color/stat_rent_text"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:lineSpacingExtra="4dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/actionsHeaderTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="Quick Actions"
                android:textColor="@color/on_surface"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/tenantCountCard"
                app:layout_constraintStart_toStartOf="parent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/addTenantButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:text="ADD NEW TENANT"
                android:textSize="15sp"
                android:letterSpacing="0.05"
                android:textStyle="bold"
                app:cornerRadius="14dp"
                android:backgroundTint="@color/primary"
                app:elevation="3dp"
                app:layout_constraintTop_toBottomOf="@id/actionsHeaderTextView"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/viewTenantsButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:text="VIEW ALL TENANTS"
                android:textSize="15sp"
                android:letterSpacing="0.05"
                android:textStyle="bold"
                android:textColor="@color/primary"
                app:strokeColor="@color/primary"
                app:strokeWidth="1.5dp"
                app:cornerRadius="14dp"
                app:layout_constraintTop_toBottomOf="@id/addTenantButton"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</layout>
